# Telegram Bot — environment configuration example
# Copy to .env and fill in values

# ── Required ──────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# ── Auth ──────────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to use the bot
# Get your user ID from @userinfobot on Telegram
# Leave empty to allow all users (NOT recommended for production)
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Minoverse API ─────────────────────────────────────────────────────────────
MINOVERSE_API_URL=http://localhost:8000
# MINOVERSE_API_KEY=  # optional

# ── Webhook (production only) ─────────────────────────────────────────────────
# Leave empty for polling mode (development)
# TELEGRAM_WEBHOOK_URL=https://your-domain.com

# ── Defaults ──────────────────────────────────────────────────────────────────
DEFAULT_INGEST_MODE=technical

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
