# AutoIngest CLI — environment configuration example
# Copy this to .env and fill in your values

# ── Minoverse API ─────────────────────────────────────────────────────────────
MINOVERSE_API_URL=http://localhost:8000
# MINOVERSE_API_KEY=your-api-key-here   # optional, if auth is enabled

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Choose one or more. The CLI will use DEFAULT_PROVIDER.

# Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.2

# OpenAI (uncomment to use)
# OPENAI_API_KEY=sk-...
# DEFAULT_PROVIDER=openai
# DEFAULT_MODEL=gpt-4o-mini

# Anthropic (uncomment to use)
# ANTHROPIC_API_KEY=sk-ant-...
# DEFAULT_PROVIDER=anthropic
# DEFAULT_MODEL=claude-3-5-haiku-20241022

# ── Queue ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
USE_NATS=false

# ── Ingest Settings ───────────────────────────────────────────────────────────
INGEST_TIMEOUT_MS=30000
INGEST_MAX_RETRIES=3
INGEST_RATE_LIMIT_DELAY_MS=1000

# ── Scraping ──────────────────────────────────────────────────────────────────
PLAYWRIGHT_TIMEOUT_MS=15000

# ── Output ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
OUTPUT_FORMAT=pretty
