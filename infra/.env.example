# PostgreSQL
POSTGRES_USER=minoverse
POSTGRES_PASSWORD=minoverse
POSTGRES_DB=minoverse

# Redis
REDIS_URL=redis://localhost:6379/0

# API
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
CHAT_MODEL=qwen3

# ── AutoIngest ────────────────────────────────────────────────────────────────

# LLM Providers (at least one required for AutoIngest CLI + Agent)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEYS=

# NATS (message queue — used if USE_NATS=true)
NATS_URL=nats://localhost:4222
USE_NATS=false

# GitHub (optional — increases rate limits for GitHub scraping)
# GITHUB_TOKEN=ghp_...

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Required only if running the Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_WEBHOOK_URL=https://your-domain.com

